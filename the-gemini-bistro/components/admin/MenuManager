import React, { useState, useEffect } from 'react';
import { motion, AnimatePresence } from 'framer-motion';
import { fetchMenu, addMenuItem, updateMenuItem, deleteMenuItem } from '../../services/apiService';
import { MenuItem } from '../../types';
import { logError } from '../../services/monitoringService';

const emptyFormState = {
    name: '',
    category: 'Appetizers' as MenuItem['category'],
    price: '',
    description: '',
    ingredients: '',
    tags: '',
};

const MenuManager: React.FC = () => {
    const [menu, setMenu] = useState<MenuItem[]>([]);
    const [isLoading, setIsLoading] = useState(true);
    const [isModalOpen, setIsModalOpen] = useState(false);
    const [editingItem, setEditingItem] = useState<typeof emptyFormState & { originalName?: string } | null>(null);

    const loadMenu = async () => {
        setIsLoading(true);
        try {
            const data = await fetchMenu();
            setMenu(data);
        } catch (error) {
            console.error("Failed to load menu", error);
            logError(error as Error, { context: "Admin: Load Menu" });
        } finally {
            setIsLoading(false);
        }
    };

    useEffect(() => {
        loadMenu();
    }, []);

    const openModalForEdit = (item: MenuItem) => {
        setEditingItem({
            ...item,
            originalName: item.name,
            ingredients: item.ingredients.join(', '),
            tags: item.tags?.join(', ') || '',
        });
        setIsModalOpen(true);
    };
    
    const openModalForNew = () => {
        setEditingItem(emptyFormState);
        setIsModalOpen(true);
    };
    
    const handleFormChange = (e: React.ChangeEvent<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>) => {
        if (!editingItem) return;
        setEditingItem({ ...editingItem, [e.target.name]: e.target.value });
    };

    const handleFormSubmit = async (e: React.FormEvent) => {
        e.preventDefault();
        if (!editingItem) return;
        
        const { originalName, ...itemData } = editingItem;
        const isEditing = !!originalName;

        try {
            const apiPayload = {
                ...itemData,
                ingredients: itemData.ingredients.split(',').map(i => i.trim()).filter(Boolean),
                tags: itemData.tags.split(',').map(t => t.trim()).filter(Boolean),
            };

            if (isEditing) {
                await updateMenuItem({ ...apiPayload, name: originalName! });
            } else {
                await addMenuItem(apiPayload);
            }
            setIsModalOpen(false);
            setEditingItem(null);
            loadMenu();
        } catch (error) {
            console.error("Failed to save menu item", error);
            logError(error as Error, { context: "Admin: Save Menu Item", itemData });
        }
    };

    const handleDelete = async (itemName: string) => {
        if (window.confirm(`Are you sure you want to delete "${itemName}"?`)) {
            try {
                await deleteMenuItem(itemName);
                loadMenu();
            } catch (error) {
                console.error("Failed to delete menu item", error);
                logError(error as Error, { context: "Admin: Delete Menu Item", itemName });
            }
        }
    };

    if (isLoading) {
        return <div className="text-center p-8 text-gray-400">Loading menu data...</div>;
    }

    return (
        <div>
            <div className="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-6">
                <div>
                    <h2 className="text-2xl font-bold text-white">Menu Items</h2>
                    <p className="text-sm text-gray-400">{menu.length} total items in catalog</p>
                </div>
                <button
                    onClick={openModalForNew}
                    className="w-full sm:w-auto px-4 py-2.5 min-h-[44px] bg-amber-500 text-white font-semibold rounded-xl hover:bg-amber-600 transition shadow-md shadow-amber-500/20 flex items-center justify-center gap-2"
                >
                    <span>+</span>
                    <span>Add New Item</span>
                </button>
            </div>

            {/* Desktop Table */}
            <div className="hidden md:block bg-gray-800 rounded-xl shadow-lg border border-gray-700/60 overflow-hidden">
                <table className="w-full text-left">
                    <thead className="bg-gray-750 border-b border-gray-700">
                        <tr>
                            <th className="p-4 font-semibold text-gray-300">Name</th>
                            <th className="p-4 font-semibold text-gray-300">Category</th>
                            <th className="p-4 font-semibold text-gray-300">Price</th>
                            <th className="p-4 font-semibold text-gray-300">Tags</th>
                            <th className="p-4 font-semibold text-gray-300 text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody className="divide-y divide-gray-750">
                        {menu.map(item => (
                            <tr key={item.name} className="hover:bg-gray-700/40 transition">
                                <td className="p-4 font-medium text-white">{item.name}</td>
                                <td className="p-4 text-gray-300">{item.category}</td>
                                <td className="p-4 font-semibold text-amber-400">{item.price}</td>
                                <td className="p-4">
                                    <div className="flex flex-wrap gap-1">
                                        {item.tags?.map(t => (
                                            <span key={t} className="text-xs px-2 py-0.5 rounded bg-gray-700 text-gray-300">{t}</span>
                                        ))}
                                    </div>
                                </td>
                                <td className="p-4 text-right space-x-3">
                                    <button onClick={() => openModalForEdit(item)} className="text-amber-400 hover:text-amber-300 font-medium">Edit</button>
                                    <button onClick={() => handleDelete(item.name)} className="text-red-400 hover:text-red-300 font-medium">Delete</button>
                                </td>
                            </tr>
                        ))}
                    </tbody>
                </table>
            </div>

            {/* Mobile / Tablet Cards View */}
            <div className="md:hidden space-y-3">
                {menu.map(item => (
                    <div key={item.name} className="bg-gray-800 p-4 rounded-xl border border-gray-700/60 shadow-md flex flex-col justify-between gap-3">
                        <div className="flex justify-between items-start gap-2">
                            <div>
                                <h3 className="font-bold text-white text-base">{item.name}</h3>
                                <p className="text-xs text-gray-400 mt-0.5">{item.category}</p>
                            </div>
                            <span className="text-amber-400 font-bold text-base whitespace-nowrap bg-gray-900/60 px-2 py-0.5 rounded-lg border border-gray-700">
                                {item.price}
                            </span>
                        </div>
                        <p className="text-xs text-gray-300 line-clamp-2">{item.description}</p>
                        {item.tags && item.tags.length > 0 && (
                            <div className="flex flex-wrap gap-1">
                                {item.tags.map(t => (
                                    <span key={t} className="text-[11px] px-2 py-0.5 rounded bg-gray-750 text-gray-300 border border-gray-700">{t}</span>
                                ))}
                            </div>
                        )}
                        <div className="flex items-center justify-end gap-3 pt-2 border-t border-gray-700/50">
                            <button
                                onClick={() => openModalForEdit(item)}
                                className="px-3 py-1.5 text-xs font-semibold bg-gray-700 text-amber-300 rounded-lg hover:bg-gray-650 min-h-[36px] flex items-center"
                            >
                                Edit
                            </button>
                            <button
                                onClick={() => handleDelete(item.name)}
                                className="px-3 py-1.5 text-xs font-semibold bg-red-900/40 text-red-300 border border-red-800/50 rounded-lg hover:bg-red-900/60 min-h-[36px] flex items-center"
                            >
                                Delete
                            </button>
                        </div>
                    </div>
                ))}
            </div>
            
            <AnimatePresence>
                {isModalOpen && editingItem && (
                    <motion.div 
                        className="fixed inset-0 bg-black/70 z-50 flex items-center justify-center p-3 sm:p-4 backdrop-blur-sm"
                        initial={{ opacity: 0 }}
                        animate={{ opacity: 1 }}
                        exit={{ opacity: 0 }}
                    >
                        <motion.div 
                            className="bg-gray-800 rounded-2xl shadow-2xl w-full max-w-2xl max-h-[90vh] overflow-y-auto border border-gray-700/80"
                            initial={{ scale: 0.95, y: 15 }}
                            animate={{ scale: 1, y: 0 }}
                            exit={{ scale: 0.95, y: 15 }}
                        >
                            <form onSubmit={handleFormSubmit}>
                                <div className="p-5 sm:p-6">
                                    <h3 className="text-xl font-bold text-amber-400 mb-5">{editingItem.originalName ? 'Edit' : 'Add'} Menu Item</h3>
                                    <div className="space-y-4">
                                        <div>
                                            <label className="block text-xs font-medium text-gray-300 mb-1">Name</label>
                                            <input name="name" value={editingItem.name} onChange={handleFormChange} required disabled={!!editingItem.originalName} className="w-full p-2.5 bg-gray-700/90 rounded-xl border border-gray-600 disabled:opacity-50 text-white min-h-[44px]" />
                                            {!!editingItem.originalName && <p className="text-xs text-gray-400 mt-1">Item name cannot be changed.</p>}
                                        </div>
                                       <div className="grid grid-cols-1 sm:grid-cols-2 gap-4">
                                            <div>
                                                <label className="block text-xs font-medium text-gray-300 mb-1">Category</label>
                                                <select name="category" value={editingItem.category} onChange={handleFormChange} className="w-full p-2.5 bg-gray-700/90 rounded-xl border border-gray-600 text-white min-h-[44px]">
                                                    <option>Appetizers</option>
                                                    <option>Main Courses</option>
                                                    <option>Desserts</option>
                                                    <option>Beverages</option>
                                                </select>
                                            </div>
                                            <div>
                                                <label className="block text-xs font-medium text-gray-300 mb-1">Price</label>
                                                <input name="price" value={editingItem.price} onChange={handleFormChange} required placeholder="$12.00" className="w-full p-2.5 bg-gray-700/90 rounded-xl border border-gray-600 text-white min-h-[44px]" />
                                            </div>
                                        </div>
                                        <div>
                                            <label className="block text-xs font-medium text-gray-300 mb-1">Description</label>
                                            <textarea name="description" value={editingItem.description} onChange={handleFormChange} required rows={3} className="w-full p-2.5 bg-gray-700/90 rounded-xl border border-gray-600 text-white"></textarea>
                                        </div>
                                        <div>
                                            <label className="block text-xs font-medium text-gray-300 mb-1">Ingredients (comma-separated)</label>
                                            <input name="ingredients" value={editingItem.ingredients} onChange={handleFormChange} required className="w-full p-2.5 bg-gray-700/90 rounded-xl border border-gray-600 text-white min-h-[44px]" />
                                        </div>
                                        <div>
                                            <label className="block text-xs font-medium text-gray-300 mb-1">Tags (comma-separated)</label>
                                            <input name="tags" value={editingItem.tags} onChange={handleFormChange} placeholder="e.g. vegan, gluten-free" className="w-full p-2.5 bg-gray-700/90 rounded-xl border border-gray-600 text-white min-h-[44px]" />
                                        </div>
                                    </div>
                                </div>
                                <div className="p-4 bg-gray-900 border-t border-gray-700/60 flex flex-col sm:flex-row justify-end gap-2.5 sm:gap-3">
                                    <button type="button" onClick={() => setIsModalOpen(false)} className="w-full sm:w-auto px-5 py-2.5 bg-gray-700 hover:bg-gray-600 text-white rounded-xl min-h-[44px]">Cancel</button>
                                    <button type="submit" className="w-full sm:w-auto px-5 py-2.5 bg-amber-500 hover:bg-amber-600 text-white font-semibold rounded-xl shadow-md shadow-amber-500/20 min-h-[44px]">Save Item</button>
                                </div>
                            </form>
                        </motion.div>
                    </motion.div>
                )}
            </AnimatePresence>
        </div>
    );
};

export default MenuManager;
